    {
      "type": "timeseries",
      "title": "Handling time p95",
      "description": "95th percentile time each service takes to handle a gRPC call.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (job, le) (rate(grpc_server_handling_seconds_bucket{namespace=\"testbed\"}[1m])))",
          "legendFormat": "{{job}}",
          "instant": false,
          "range": true
