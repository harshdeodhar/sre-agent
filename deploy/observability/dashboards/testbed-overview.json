    {
      "type": "timeseries",
      "title": "Failure ratio",
      "description": "Share of gRPC calls that failed because of the service or its dependencies. Caller mistakes (NotFound, FailedPrecondition, InvalidArgument) are excluded.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "(sum by (job) (rate(grpc_server_handled_total{namespace=\"testbed\", grpc_code!~\"OK|InvalidArgument|NotFound|FailedPrecondition|AlreadyExists|Canceled\"}[1m])) or sum by (job) (rate(grpc_server_handled_total{namespace=\"testbed\"}[1m])) * 0) / sum by (job) (rate(grpc_server_handled_total{namespace=\"testbed\"}[1m]))",
          "legendFormat": "{{job}}",
          "instant": false,
          "range": true
        }
      ],
